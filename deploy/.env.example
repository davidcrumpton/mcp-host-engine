# ---------------------------------------------------------------------------
# Copy to deploy/.env and edit.  Everything here is injected into the container
# as plain environment variables — which is exactly what mcphe's `env://`
# resolver and `host.process.env()` read.
#
# This file is the ONLY place per-plugin credentials live, which is why adding
# or removing a plugin never requires rebuilding the image:
#
#   1. add/remove the plugin block in deploy/config.<mode>.yaml
#   2. add/remove its variables here
#   3. restart the container
#
# Guard rail: a plugin can only see variables named in its own
# `allowed_env_vars:` list. Everything else in this file is invisible to it.
#
# Guard rail: `env://` refs in the config are FATAL at startup when unset —
# mcphe exits with `environment variable "X" is not set`. If you comment a
# plugin out of the config, comment its variables out here too.
#
# Never commit deploy/.env (it is in .gitignore and .dockerignore).
# ---------------------------------------------------------------------------

# --- server secrets --------------------------------------------------------
# Signing key for bearer tokens. Generate once, e.g.:
#   openssl rand -base64 48
MCPHE_TOKEN_SECRET=replace-me-with-a-long-random-string

# Revocation list, on the mounted state volume so it survives restarts and can
# be edited by `mcphe token revoke` running on the host.
MCPHE_REVOKE_FILE=/var/lib/mcphe/revocations.yaml

# Some plugins resolve `env://USER` for audit logging; containers have no user
# entry unless you set one.
USER=mcphe

# --- plugin credentials (uncomment what you use) ---------------------------
# GITLAB_API_KEY=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_ALLOWED_DOMAINS=gitlab.crumpton.org

# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=eyJhbGciOi...

# ZABBIX_API_URL=https://zabbix.crumpton.org
# ZABBIX_USER=svc-mcphe
# ZABBIX_PASSWORD=
# ZABBIX_AUTH_TOKEN=

# WIKIJS_API_URL=https://wiki.crumpton.org
# WIKIJS_API_TOKEN=

# GITEA_API_URL=https://git.crumpton.org
# GITEA_API_KEY=

# OPENSEARCH_BASE_URL=https://opensearch.crumpton.org
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# KIBANA_BASE_URL=https://elk.crumpton.org
# KIBANA_USERNAME=
# KIBANA_PASSWORD=

# PROXMOX_BASE_URL=https://pve02.crumpton.org:8006
# PROXMOX_API_TOKEN=

# MCWSD_BASE_URL=https://docker-vm.crumpton.org:9080
# MCWSD_TOKEN=

# --- Vault (optional, resolves vault:// refs in config) --------------------
# Vault is reached over the network from inside the container, so the address
# must not be localhost unless Vault runs in the same container.
# VAULT_ADDR=http://192.168.64.1:8200
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
