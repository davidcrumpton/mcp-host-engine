# Keep the build context small and free of secrets.
.git
.github
.gitlab-ci.yml
.vscode
.claude

# Never bake runtime secrets into an image.
deploy/.env
deploy/.env.*
!deploy/.env.example
deploy/state
revocations.yaml
*.pem
*.key
# The repo-root config.yaml is a local development file. The image ships
# deploy/config.*.yaml instead, so this must not reach the build context.
config.yaml

# Build artifacts / editor noise
mcphe
dist
plugin-devel
tests/results
tls
docs
images
*.swp
